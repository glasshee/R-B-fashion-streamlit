            <img src="${item.image}" alt="${item.name}" loading="lazy">
          </a>
        </div>
        <div class="cart-item__details">
          <h4 class="cart-item__name">
            <a href="product.html?id=${item.productId}">${item.name}</a>
          </h4>
          <p class="cart-item__meta">Size: ${item.size} | ${item.category}</p>
          <p class="cart-item__price">${Helpers.formatPrice(item.price * item.quantity)}</p>
          <div class="cart-item__actions">
            <div class="quantity-selector">
              <button class="quantity-selector__btn" data-action="decrease" data-item="${item.id}">−</button>
              <input type="number" class="quantity-selector__input" value="${item.quantity}" min="1" max="10" data-item="${item.id}" aria-label="Quantity">
              <button class="quantity-selector__btn" data-action="increase" data-item="${item.id}">+</button>
            </div>
            <button class="cart-item__remove" data-remove="${item.id}">Remove</button>
          </div>
        </div>
      </div>
    `).join('');

    // Summary
    const subtotal = Cart.getSubtotal();
    if (summaryContainer) {
      summaryContainer.innerHTML = `
        <h3 class="cart-summary__title">Order Summary</h3>
        <div class="cart-summary__row">
          <span>Subtotal (${Cart.getItemCount()} items)</span>
          <span>${Helpers.formatPrice(subtotal)}</span>
        </div>
        <div class="cart-summary__row">
          <span>Delivery</span>
          <span style="color: var(--color-gray);">Calculated at checkout</span>
        </div>
        <div class="cart-summary__row cart-summary__row--total">
          <span>Total</span>
          <span>${Helpers.formatPrice(subtotal)}</span>
        </div>
        <div class="cart-summary__buttons">
          <a href="checkout.html" class="btn btn--primary btn--full btn--lg">Proceed to Checkout</a>
          <a href="shop.html" class="btn btn--secondary btn--full">Continue Shopping</a>
        </div>
      `;
    }

    this.bindEvents();
  },

  bindEvents() {
    // Quantity buttons
    document.querySelectorAll('.cart-item .quantity-selector__btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const itemId = btn.dataset.item;
        const item = Cart.items.find(i => i.id === itemId);
        if (!item) return;

        if (btn.dataset.action === 'increase' && item.quantity < 10) {
          Cart.updateQuantity(itemId, item.quantity + 1);
        } else if (btn.dataset.action === 'decrease') {
          Cart.updateQuantity(itemId, item.quantity - 1);
        }
        this.render();
      });
    });

    // Remove buttons
    document.querySelectorAll('[data-remove]').forEach(btn => {
      btn.addEventListener('click', () => {
        Cart.removeItem(btn.dataset.remove);
        this.render();
        Toast.show('Item removed from cart', 'info');
      });
    });
  }
};

