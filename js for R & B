// js/components/filters.js

const Filters = {
  state: {
    search: '',
    categories: [],
    genders: [],
    priceMin: null,
    priceMax: null,
    sizes: [],
    sort: 'newest'
  },

  init(options = {}) {
    this.onUpdate = options.onUpdate || (() => {});
    this.bindEvents();
  },

  bindEvents() {
    // Search
    const searchInput = document.querySelector('.shop-toolbar__search input');
    if (searchInput) {
      searchInput.addEventListener('input', Helpers.debounce((e) => {
        this.state.search = e.target.value.toLowerCase();
        this.onUpdate();
      }, 300));
    }

    // Sort
    const sortSelect = document.querySelector('.shop-toolbar__sort select');
    if (sortSelect) {
      sortSelect.addEventListener('change', (e) => {
        this.state.sort = e.target.value;
        this.onUpdate();
      });
    }

    // Filter options
    document.querySelectorAll('.filter-option').forEach(option => {
      option.addEventListener('click', () => {
        option.classList.toggle('active');
        this.collectFilters();
        this.onUpdate();
      });
    });

    // Filter group collapse
    document.querySelectorAll('.filter-group__title').forEach(title => {
      title.addEventListener('click', () => {
        title.closest('.filter-group').classList.toggle('collapsed');
      });
    });

    // Price range
    const priceMin = document.querySelector('.price-range__input[data-price="min"]');
    const priceMax = document.querySelector('.price-range__input[data-price="max"]');
    if (priceMin) {
      priceMin.addEventListener('input', Helpers.debounce(() => {
        this.state.priceMin = priceMin.value ? parseInt(priceMin.value) : null;
        this.onUpdate();
      }, 500));
    }
    if (priceMax) {
      priceMax.addEventListener('input', Helpers.debounce(() => {
        this.state.priceMax = priceMax.value ? parseInt(priceMax.value) : null;
        this.onUpdate();
      }, 500));
    }

    // Mobile filter toggle
    const filterToggle = document.querySelector('.shop-toolbar__filter-btn');
    const sidebar = document.querySelector('.shop-sidebar');
    const sidebarClose = document.querySelector('.shop-sidebar__close');

    if (filterToggle && sidebar) {
      filterToggle.addEventListener('click', () => {
        sidebar.classList.add('mobile-open');
        document.body.classList.add('no-scroll');
      });
    }

    if (sidebarClose && sidebar) {
      sidebarClose.addEventListener('click', () => {
        sidebar.classList.remove('mobile-open');
        document.body.classList.remove('no-scroll');
      });
    }
  },

  collectFilters() {
    this.state.categories = [];
    this.state.genders = [];
    this.state.sizes = [];

    document.querySelectorAll('.filter-option.active').forEach(option => {
      const type = option.dataset.filterType;
      const value = option.dataset.filterValue;
      if (type === 'category') this.state.categories.push(value);
      else if (type === 'gender') this.state.genders.push(value);
      else if (type === 'size') this.state.sizes.push(value);
    });
  },

  apply(products) {
    let filtered = [...products];

    // Search
    if (this.state.search) {
      filtered = filtered.filter(p =>
        p.name.toLowerCase().includes(this.state.search) ||
        p.category.toLowerCase().includes(this.state.search) ||
        p.tags.some(t => t.includes(this.state.search))
      );
    }

    // Categories
    if (this.state.categories.length > 0) {
      filtered = filtered.filter(p => this.state.categories.includes(p.category));
    }

    // Gender
    if (this.state.genders.length > 0) {
      filtered = filtered.filter(p => this.state.genders.includes(p.gender));
    }

    // Price range
    if (this.state.priceMin !== null) {
      filtered = filtered.filter(p => p.price >= this.state.priceMin);
    }
    if (this.state.priceMax !== null) {
      filtered = filtered.filter(p => p.price <= this.state.priceMax);
    }

    // Sizes
    if (this.state.sizes.length > 0) {
      filtered = filtered.filter(p => p.sizes.some(s => this.state.sizes.includes(s)));
    }

    // Sort
    switch (this.state.sort) {
      case 'price-low':
        filtered.sort((a, b) => a.price - b.price);
        break;
      case 'price-high':
        filtered.sort((a, b) => b.price - a.price);
        break;
      case 'name':
        filtered.sort((a, b) => a.name.localeCompare(b.name));
        break;
      case 'newest':
      default:
        filtered.sort((a, b) => (b.isNew ? 1 : 0) - (a.isNew ? 1 : 0));
        break;
    }

    return filtered;
  }
};

// js/components/forms.js

const FormValidator = {
  validate(form) {
    let isValid = true;
    const fields = form.querySelectorAll('[required]');

    // Clear previous errors
    form.querySelectorAll('.form-error').forEach(err => err.remove());
    form.querySelectorAll('.error').forEach(el => el.classList.remove('error'));

    fields.forEach(field => {
      const value = field.value.trim();

      if (!value) {
        this.showError(field, 'This field is required');
        isValid = false;
      } else if (field.type === 'email' && !this.isValidEmail(value)) {
        this.showError(field, 'Please enter a valid email');
        isValid = false;
      } else if (field.type === 'tel' && !this.isValidPhone(value)) {
        this.showError(field, 'Please enter a valid phone number');
        isValid = false;
      }
    });

    return isValid;
  },

  showError(field, message) {
    field.classList.add('error');
    const errorDiv = document.createElement('div');
    errorDiv.className = 'form-error';
    errorDiv.textContent = message;
    field.parentNode.appendChild(errorDiv);
  },

  isValidEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  },

  isValidPhone(phone) {
    return /^[\d\s+\-()]{8,}$/.test(phone);
  }
};

